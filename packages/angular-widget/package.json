{
  "name": "@snipet/angular-widget",
  "version": "0.0.0",
  "description": "Angular bindings for the Snipet chat widget.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usesnipet/snipet.git",
    "directory": "packages/angular-widget"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc"
  },
  "dependencies": {
    "@snipet/widget": "workspace:*"
  },
  "peerDependencies": {
    "@angular/common": ">=19",
    "@angular/core": ">=19"
  },
  "devDependencies": {
    "@angular/common": "^22.2.3",
    "@angular/core": "^22.2.3",
    "rxjs": "^7.8.2",
    "typescript": "~6.0.3"
  }
}
