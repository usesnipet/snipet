PORT=3000
# Built web app served by the API; defaults to apps/web/dist
# WEB_DIR=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/snipet
# Run pending migrations on boot
DB_AUTO_MIGRATE=true

# At least 32 chars: node -e 'console.log(require("crypto").randomBytes(48).toString("base64url"))'
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=2592000
# Browser origins allowed to call the API (widget host pages), comma-separated; * = any
CORS_ORIGINS=http://localhost:5174
# 32 bytes, base64. Encrypts LLM connection credentials; losing/changing it makes them unreadable.
# node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
ENCRYPTION_KEY=
# First admin, created on an empty users table. Unset password = random, logged once.
ROOT_USERNAME=admin
ROOT_PASSWORD=admin

# Base URL the server is reached at, used to build public file URLs. Default http://localhost:$PORT
# PUBLIC_URL=

# Uploaded files (agent avatars): fs (local dir) or s3 (S3 or S3-compatible bucket)
STORAGE_DRIVER=fs
# Defaults to apps/api/storage
# STORAGE_FS_DIR=
# Empty endpoint = AWS S3; empty keys = AWS default chain. Bucket required when STORAGE_DRIVER=s3
STORAGE_S3_ENDPOINT=http://localhost:9000
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_S3_PREFIX=
STORAGE_S3_ACCESS_KEY_ID=minioadmin
STORAGE_S3_SECRET_ACCESS_KEY=minioadmin
STORAGE_S3_FORCE_PATH_STYLE=true
