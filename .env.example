PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/snipet
# Run pending migrations on boot
DB_AUTO_MIGRATE=true

# At least 32 chars: node -e 'console.log(require("crypto").randomBytes(48).toString("base64url"))'
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=2592000
# First admin, created on an empty users table. Unset password = random, logged once.
ROOT_USERNAME=admin
ROOT_PASSWORD=admin
