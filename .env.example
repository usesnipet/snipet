PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/snipet
# Run pending migrations on boot
DB_AUTO_MIGRATE=true

# At least 32 chars: node -e 'console.log(require("crypto").randomBytes(48).toString("base64url"))'
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=2592000
# 32 bytes, base64. Encrypts LLM connection credentials; losing/changing it makes them unreadable.
# node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
ENCRYPTION_KEY=
# First admin, created on an empty users table. Unset password = random, logged once.
ROOT_USERNAME=admin
ROOT_PASSWORD=admin
# Seconds between MCP server tool syncs; 0 disables periodic syncs
MCP_SYNC_INTERVAL_SECONDS=300
# MCP server syncs running at once, per API instance
MCP_SYNC_CONCURRENCY=4

# Knowledge (RAG). Off unless KNOWLEDGE_S3_BUCKET and PGVECTOR_URL are set.
# Source: an S3 or S3-compatible bucket. Empty endpoint = AWS S3; empty keys = AWS default chain.
KNOWLEDGE_S3_ENDPOINT=http://localhost:9000
KNOWLEDGE_S3_REGION=us-east-1
KNOWLEDGE_S3_BUCKET=
KNOWLEDGE_S3_PREFIX=
KNOWLEDGE_S3_ACCESS_KEY_ID=minioadmin
KNOWLEDGE_S3_SECRET_ACCESS_KEY=minioadmin
# MinIO and most S3-compatible services need path-style addressing
KNOWLEDGE_S3_FORCE_PATH_STYLE=true
# Seconds between source syncs; 0 disables periodic syncs
KNOWLEDGE_SYNC_INTERVAL_SECONDS=300
KNOWLEDGE_INDEX_CONCURRENCY=2
CHUNK_MAX_CHARACTERS=1000
CHUNK_OVERLAP=200
# Separate Postgres with pgvector for chunks; its schema is applied on boot
PGVECTOR_URL=postgresql://postgres:postgres@localhost:5434/snipet_rag
# Postgres text search config for keyword search (simple = no stemming, any language).
# EMBEDDING_DIMENSIONS and FTS_LANGUAGE shape the chunks table: to change either,
# drop knowledge_chunks and reindex (set every knowledge item back to pending).
FTS_LANGUAGE=simple
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=mxbai-embed-large:latest
# At most 2000 (pgvector HNSW index limit)
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=100

# Redis for BullMQ queues
REDIS_URL=redis://localhost:6379
