# Copy to .env and adjust. cmd/scaffold does this for you on first run.

# --- environment ---
ENV=development

# --- server (SERVER_ prefix) ---
SERVER_PORT=8080
SERVER_SHUTDOWN_TIMEOUT=15s

# --- database (DB_ prefix) ---
DB_URL=postgres://postgres:postgres@localhost:5432/snipet?sslmode=disable
DB_AUTO_MIGRATE=true
DB_AUTO_CREATE=true
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_MIGRATION_DIR=migrations
# Run an ephemeral embedded Postgres instead of DB_URL (dev only):
# DB_EMBEDDED=true
# DB_EMBEDDED_DATA_PATH=

# --- logging (LOG_ prefix) ---
LOG_LEVEL=info

# --- auth (AUTH_ prefix) ---
AUTH_BASIC_AUTH_USERNAME=admin
AUTH_BASIC_AUTH_PASSWORD=change-me-in-production
AUTH_JWT_SECRET=change-me-in-production
AUTH_JWT_EXPIRATION=15m
AUTH_JWT_ISSUER=https://snipet.example.com
AUTH_JWT_AUDIENCE=https://snipet.example.com
AUTH_REFRESH_TOKEN_EXPIRATION=720h
# Root account, auto-provisioned on first boot (empty users table only):
AUTH_ROOT_USERNAME=admin
AUTH_ROOT_PASSWORD=admin
# Set true + restart to regenerate the root password (logged once at WARN);
# set back to false afterwards.
AUTH_ROOT_PASSWORD_RESET=false

# --- background workers (SYNC_ prefix) ---
SYNC_WORKERS=4
