{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenAI-compatible provider auth",
  "type": "object",
  "required": ["api_key"],
  "additionalProperties": false,
  "properties": {
    "api_key": {
      "type": "string",
      "minLength": 1,
      "description": "Bearer token sent as Authorization: Bearer <api_key>"
    }
  }
}
