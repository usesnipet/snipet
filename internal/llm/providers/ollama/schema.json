{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "api_key": {
      "type": "string",
      "description": "Groq API key"
    },
    "model": {
      "type": "string",
      "description": "Model ID used to generate the response"
    },
    "temperature": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    },
    "max_tokens": {
      "type": "integer",
      "minimum": 1
    },
    "top_p": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "required": ["model"],
  "additionalProperties": false
}
