---
import "../styles/landing.css";
import { Channels } from "../components/landing/Channels";
import { Footer } from "../components/landing/Footer";
import { Hero } from "../components/landing/Hero";
import { HowItWorks } from "../components/landing/HowItWorks";
import { Models, type Manifest } from "../components/landing/Models";
import { OpenSource } from "../components/landing/OpenSource";
import { Plugins } from "../components/landing/Plugins";
import { Roadmap, type Milestone } from "../components/landing/Roadmap";
import { Waitlist } from "../components/landing/Waitlist";

/** Closed milestones shown before the open ones. */
const SHIPPED_COUNT = 4;

/**
 * The API's manifests in `dir` on GitHub's default branch, so the site builds without the API sources (e.g. in Docker).
 * Throws instead of degrading like the roadmap: a landing without the catalog shouldn't ship silently.
 */
async function loadManifests(dir: string): Promise<Manifest[]> {
  const res = await fetch(`https://api.github.com/repos/usesnipet/snipet/contents/apps/api/src/${dir}/manifests`);
  if (!res.ok) throw new Error(`Listing ${dir} manifests on GitHub failed: ${res.status}`);
  const files = (await res.json()) as { name: string; download_url: string }[];
  return Promise.all(
    files.filter((f) => f.name.endsWith(".json")).map(async (f) => (await fetch(f.download_url)).json() as Promise<Manifest>),
  );
}
const [models, allPlugins] = await Promise.all([loadManifests("llm"), loadManifests("plugin")]);
const plugins = allPlugins.filter((p) => p.key !== "mcp");

/** Roadmap from the repo milestones, fetched at build time; empty when GitHub is unreachable. */
async function loadRoadmap(): Promise<Milestone[]> {
  try {
    const res = await fetch("https://api.github.com/repos/usesnipet/snipet/milestones?state=all&per_page=100");
    if (!res.ok) return [];
    const all = ((await res.json()) as Milestone[])
      // Patch releases (x.y.1+) are fixes, too small for the roadmap.
      .filter((m) => !/^\d+\.\d+\.[1-9]/.test(m.title))
      .sort((a, b) => (a.due_on ?? "").localeCompare(b.due_on ?? ""));
    const closed = all.filter((m) => m.state === "closed").slice(-SHIPPED_COUNT);
    return [...closed, ...all.filter((m) => m.state === "open")];
  } catch {
    return [];
  }
}
const roadmap = await loadRoadmap();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Snipet</title>
    <meta
      name="description"
      content="Open-source platform to build AI agents that connect to your tools and can be called from anywhere."
    />
  </head>
  <body class="min-h-screen bg-white text-gray-900 antialiased">
    <main>
      <Hero />
      <HowItWorks />
      <Models models={models} />
      <Plugins plugins={plugins} />
      <Channels />
      <Roadmap roadmap={roadmap} />
      <OpenSource />
      <Waitlist client:visible />
    </main>
    <Footer />
  </body>
</html>
