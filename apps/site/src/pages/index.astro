---
import { WEB3FORMS_ACCESS_KEY } from "astro:env/server";
import "../styles/landing.css";
import Channels from "../components/landing/channel/channels.astro";
import { Faq, faqs } from "../components/landing/faq";
import { Footer } from "../components/landing/footer";
import { GetStarted } from "../components/landing/get-started";
import { Header } from "../components/landing/header";
import { Hero } from "../components/landing/hero";
import { HowItWorks } from "../components/landing/how-it-works";
import { Models } from "../components/landing/models";
import { Plugins } from "../components/landing/plugins";
import { Roadmap } from "../components/landing/roadmap";
import { loadManifests, loadRoadmap, loadStars } from "../lib/github";

// Rendered on the server so roadmap edits show up without a rebuild; the route cache keeps GitHub calls to one
// render per maxAge (4 API calls, well under the 60/h unauthenticated limit).
export const prerender = false;

const [models, allPlugins, roadmap, stars] = await Promise.all([
  loadManifests("llm"),
  loadManifests("plugin"),
  loadRoadmap(),
  loadStars(),
]);
// A section GitHub couldn't fill is left out. Such a page isn't cached, so the next request retries; during swr
// revalidation the last complete page keeps being served.
if (models && allPlugins && roadmap && stars !== null) Astro.cache.set({ maxAge: 15 * 60, swr: 24 * 60 * 60 });
// Only the fields the list shows: Plugins hydrates on the client, so its props are serialized into the page.
const plugins = (allPlugins ?? [])
  .filter((p) => p.key !== "mcp")
  .map(({ key, name, icon, description, tags }) => ({ key, name, icon, description, tags }));

const title = "Snipet: open-source platform to build AI agents";
const description =
  "Open-source, self-hosted platform to build AI agents that connect to your tools through MCP and can be called from your API or a chat widget.";
const canonical = new URL("/", Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;
/** Lets search and AI engines identify the product and its publisher as entities. */
const jsonLd = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: "Snipet",
    url: canonical,
    description,
    applicationCategory: "DeveloperApplication",
    operatingSystem: "Docker",
    offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
    codeRepository: "https://github.com/usesnipet/snipet",
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Snipet",
    url: canonical,
    logo: new URL("/favicon.svg", Astro.site).href,
    sameAs: ["https://github.com/usesnipet", "https://www.npmjs.com/package/@snipet/widget"],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
      "@type": "Question",
      name: f.question,
      acceptedAnswer: { "@type": "Answer", text: f.answer },
    })),
  },
]);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Snipet" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={jsonLd} />
  </head>
  <body class="min-h-screen antialiased">
    <Header stars={stars} showRoadmap={!!roadmap?.length} />
    <main>
      <Hero client:load />
      <HowItWorks />
      {!!models?.length && <Models models={models} />}
      {plugins.length > 0 && <Plugins plugins={plugins} client:visible />}
      <Channels />
      <Roadmap roadmap={roadmap ?? []} />
      <GetStarted waitlistKey={WEB3FORMS_ACCESS_KEY} client:visible />
      <Faq />
    </main>
    <Footer />
  </body>
</html>
