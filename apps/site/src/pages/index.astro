---
import "../styles/landing.css";
import { Channels } from "../components/landing/Channels";
import { Footer } from "../components/landing/Footer";
import { Hero } from "../components/landing/Hero";
import { HowItWorks } from "../components/landing/HowItWorks";
import { Models } from "../components/landing/Models";
import { OpenSource } from "../components/landing/OpenSource";
import { Plugins } from "../components/landing/Plugins";
import { Roadmap } from "../components/landing/Roadmap";
import { Waitlist } from "../components/landing/Waitlist";
import { loadManifests, loadRoadmap } from "../lib/github";

// Rendered on the server so roadmap edits show up without a rebuild; the route cache keeps GitHub calls to one
// render per maxAge (3 API calls, well under the 60/h unauthenticated limit).
export const prerender = false;
// swr serves the cached page while revalidating, and keeps serving it if a refresh fails.
Astro.cache.set({ maxAge: 15 * 60, swr: 24 * 60 * 60 });

const [models, allPlugins, roadmap] = await Promise.all([loadManifests("llm"), loadManifests("plugin"), loadRoadmap()]);
const plugins = allPlugins.filter((p) => p.key !== "mcp");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Snipet</title>
    <meta
      name="description"
      content="Open-source platform to build AI agents that connect to your tools and can be called from anywhere."
    />
  </head>
  <body class="min-h-screen bg-white text-gray-900 antialiased">
    <main>
      <Hero />
      <HowItWorks />
      <Models models={models} />
      <Plugins plugins={plugins} />
      <Channels />
      <Roadmap roadmap={roadmap} />
      <OpenSource />
      <Waitlist client:visible />
    </main>
    <Footer />
  </body>
</html>
