---
import "../styles/landing.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>You're on the list · Snipet</title>
    <meta name="robots" content="noindex" />
  </head>
  <body class="min-h-screen antialiased">
    <main class="mx-auto flex max-w-xl flex-col items-center gap-6 px-4 py-32 text-center">
      <h1 class="text-4xl font-bold tracking-tight">You're on the list</h1>
      <p class="text-lg text-muted-foreground">
        We'll email you when Snipet Cloud is ready. Until then, you can self-host it today.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="/" class="rounded-lg bg-primary px-5 py-2.5 font-medium text-primary-foreground">Back to home</a>
        <a href="/docs/guides/local-setup/" class="rounded-lg border px-5 py-2.5 font-medium">Self-host now</a>
      </div>
    </main>
  </body>
</html>
