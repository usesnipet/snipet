{
  "key": "gemini",
  "name": "Google Gemini",
  "icon": "https://www.gstatic.com/lamda/images/gemini_favicon_f069958c85030456e93de685481c559f160ea06b.png",
  "description": "Google Gemini models through their OpenAI-compatible endpoint.",
  "connection": {
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "string",
        "secret": true,
        "format": "password",
        "title": "API key",
        "description": "Google Gemini API key, from aistudio.google.com/apikey."
      },
      "baseUrl": {
        "type": "string",
        "title": "Base URL",
        "description": "Optional override, defaults to https://generativelanguage.googleapis.com/v1beta/openai."
      },
      "temperature": {
        "type": "number",
        "title": "Temperature",
        "description": "How random the replies are: lower is focused and repeatable, higher is more varied and creative. Leave empty to use the model's default.",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01
      }
    },
    "required": [
      "apiKey"
    ]
  },
  "models": {
    "driver": "openai",
    "options": {
      "baseUrl": "{{ connection.baseUrl || \"https://generativelanguage.googleapis.com/v1beta/openai\" }}",
      "apiKey": "{{ connection.apiKey }}"
    }
  },
  "chat": {
    "driver": "openai",
    "options": {
      "baseUrl": "{{ connection.baseUrl || \"https://generativelanguage.googleapis.com/v1beta/openai\" }}",
      "apiKey": "{{ connection.apiKey }}",
      "temperature": "{{ connection.temperature }}"
    }
  },
  "healthCheck": {
    "driver": "http",
    "options": {
      "url": "{{ connection.baseUrl || \"https://generativelanguage.googleapis.com/v1beta/openai\" }}/models",
      "headers": {
        "Authorization": "Bearer {{ connection.apiKey }}"
      }
    }
  }
}
