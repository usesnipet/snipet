{
  "key": "openrouter",
  "name": "OpenRouter",
  "icon": "https://openrouter.ai/favicon.ico",
  "description": "OpenRouter routes one API to hundreds of models from OpenAI, Anthropic, Google, Meta and others.",
  "connection": {
    "type": "object",
    "properties": {
      "apiKey": {
        "type": "string",
        "secret": true,
        "format": "password",
        "title": "API key",
        "description": "OpenRouter API key, from openrouter.ai/keys."
      },
      "baseUrl": {
        "type": "string",
        "title": "Base URL",
        "description": "Optional override, defaults to https://openrouter.ai/api/v1."
      },
      "temperature": {
        "type": "number",
        "title": "Temperature",
        "description": "How random the replies are: lower is focused and repeatable, higher is more varied and creative. Leave empty to use the model's default.",
        "minimum": 0,
        "maximum": 1,
        "step": 0.01
      }
    },
    "required": [
      "apiKey"
    ]
  },
  "models": {
    "driver": "openai",
    "options": {
      "baseUrl": "{{ connection.baseUrl || \"https://openrouter.ai/api/v1\" }}",
      "apiKey": "{{ connection.apiKey }}"
    }
  },
  "chat": {
    "driver": "openai",
    "options": {
      "baseUrl": "{{ connection.baseUrl || \"https://openrouter.ai/api/v1\" }}",
      "apiKey": "{{ connection.apiKey }}",
      "temperature": "{{ connection.temperature }}"
    }
  },
  "healthCheck": {
    "driver": "http",
    "options": {
      "url": "{{ connection.baseUrl || \"https://openrouter.ai/api/v1\" }}/models",
      "headers": {
        "Authorization": "Bearer {{ connection.apiKey }}"
      }
    }
  }
}
