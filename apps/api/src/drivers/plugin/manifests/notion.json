{
  "key": "notion",
  "name": "Notion",
  "description": "Search, read and edit Notion pages and databases through Notion's hosted MCP server",
  "icon": "https://github.com/makenotion.png",
  "tags": ["docs", "notes"],
  "auth": {
    "type": "oauth2_discovery",
    "resource": "https://mcp.notion.com/mcp"
  },
  "capabilities": {
    "tools": {
      "driver": "mcp",
      "options": {
        "url": "https://mcp.notion.com/mcp",
        "headers": {
          "Authorization": "Bearer {{ auth.accessToken }}"
        }
      }
    },
    "instructions": {
      "driver": "mcp",
      "options": {
        "url": "https://mcp.notion.com/mcp",
        "headers": {
          "Authorization": "Bearer {{ auth.accessToken }}"
        }
      }
    }
  }
}
