{
  "key": "supabase-oauth2",
  "name": "Supabase OAuth2",
  "description": "Manage Supabase projects, databases, edge functions and docs",
  "icon": "https://github.com/supabase.png",
  "tags": ["database"],
  "auth": {
    "type": "oauth2_discovery",
    "resource": "https://mcp.supabase.com/mcp"
  },
  "capabilities": {
    "tools": {
      "driver": "mcp",
      "options": {
        "url": "https://mcp.supabase.com/mcp",
        "headers": {
          "Authorization": "Bearer {{ auth.accessToken }}"
        }
      }
    },
    "instructions": {
      "driver": "mcp",
      "options": {
        "url": "https://mcp.supabase.com/mcp",
        "headers": {
          "Authorization": "Bearer {{ auth.accessToken }}"
        }
      }
    }
  }
}
