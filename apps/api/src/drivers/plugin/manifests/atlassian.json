{
  "key": "atlassian",
  "name": "Atlassian",
  "description": "Search and edit Jira issues and Confluence pages",
  "icon": "https://github.com/atlassian.png",
  "tags": ["issues", "docs"],
  "auth": {
    "type": "oauth2_discovery",
    "resource": "https://mcp.atlassian.com/v1/mcp"
  },
  "capabilities": {
    "tools": {
      "driver": "mcp",
      "options": {
        "url": "https://mcp.atlassian.com/v1/mcp",
        "headers": {
          "Authorization": "Bearer {{ auth.accessToken }}"
        }
      }
    },
    "instructions": {
      "driver": "mcp",
      "options": {
        "url": "https://mcp.atlassian.com/v1/mcp",
        "headers": {
          "Authorization": "Bearer {{ auth.accessToken }}"
        }
      }
    }
  }
}
