{
  "key": "webhook",
  "name": "Webhook",
  "description": "Sends each hook event to a URL and uses its JSON reply: the remote service dispatches on the event's hook.",
  "icon": "",
  "tags": ["webhook", "http", "official"],
  "auth": {
    "type": "none"
  },
  "connection": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "title": "URL",
        "description": "Where the hook event is POSTed"
      },
      "Authorization": {
        "type": "string",
        "secret": true,
        "format": "password",
        "title": "Authorization",
        "description": "Sent as the Authorization header, e.g. \"Bearer <token>\"."
      },
      "secret": {
        "type": "string",
        "secret": true,
        "format": "password",
        "title": "Signing secret",
        "description": "Signs each request in the X-Snipet-Signature header (HMAC-SHA256)."
      }
    },
    "required": ["url"]
  },
  "capabilities": {
    "hooks": {
      "driver": "webhook",
      "options": {
        "url": "{{ connection.url }}",
        "headers": {
          "Authorization": "{{ connection.Authorization }}"
        },
        "signingSecret": "{{ connection.secret }}"
      },
      "handlers": [
        {
          "hook": "run.start",
          "actions": ["stop"],
          "optional": true
        },
        {
          "hook": ["run.context", "llm.response", "tool.after", "tool.error"],
          "actions": ["modify", "stop"],
          "optional": true
        },
        {
          "hook": "llm.request",
          "actions": ["modify", "respond", "stop"],
          "optional": true
        },
        {
          "hook": "tool.before",
          "actions": ["modify", "deny", "respond", "stop"],
          "optional": true
        },
        {
          "hook": "run.end",
          "background": true,
          "optional": true
        }
      ]
    }
  }
}
