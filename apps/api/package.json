{
  "name": "@snipet/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "plugins"
  ],
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config ./test/jest-e2e.json",
    "dev": "nest start --watch",
    "migration:generate": "nest build && sh -c 'typeorm -d dist/infra/database/cli-data-source.js migration:generate \"src/migrations/${1:?usage: pnpm migration:generate <Name>}\"' _",
    "migration:create": "sh -c 'typeorm migration:create \"src/migrations/${1:?usage: pnpm migration:create <Name>}\"' _",
    "migration:run": "nest build && typeorm -d dist/infra/database/cli-data-source.js migration:run",
    "migration:revert": "nest build && typeorm -d dist/infra/database/cli-data-source.js migration:revert",
    "migration:show": "nest build && typeorm -d dist/infra/database/cli-data-source.js migration:show"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "@snipet/server-common": "workspace:*",
    "@snipet/shared": "workspace:*",
    "@xberg-io/xberg": "^1.3.0",
    "bcryptjs": "^3.0.3",
    "ollama": "^0.6.4",
    "openai": "^7.25.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@snipet/shared$": "<rootDir>/../../../packages/shared/src/index.ts",
      "^@snipet/server-common$": "<rootDir>/../../../packages/server-common/src/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  }
}
