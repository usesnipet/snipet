{
  "name": "@snipet/widget",
  "version": "0.0.0",
  "description": "Snipet chat widget, one script tag on any site.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usesnipet/snipet.git",
    "directory": "apps/widget"
  },
  "files": [
    "dist"
  ],
  "unpkg": "dist/widget.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@snipet/client": "workspace:*",
    "@snipet/shared": "workspace:*",
    "@tanstack/react-query": "^5.104.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "zod": "^4.6.5"
  }
}
